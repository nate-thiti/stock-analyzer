# Database — Neon Postgres (แนะนำ)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require

JWT_SECRET=change-me-in-production-min-32-chars
APP_ENV=production
CORS_ORIGINS=https://your-app.netlify.app

SUPERADMIN_USERNAME=admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me

BMC_URL=https://ko-fi.com/yourname

# Yahoo Finance resilience (optional)
QUOTE_CACHE_SECONDS=300
HISTORY_CACHE_SECONDS=600
RAW_CACHE_SECONDS=21600
EVENT_CACHE_SECONDS=21600
STALE_CACHE_SECONDS=3600
RAW_STALE_CACHE_SECONDS=86400
YAHOO_TIMEOUT_SECONDS=12
YAHOO_MAX_WORKERS=6
