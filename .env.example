# JWT secret — เปลี่ยนใน production (อย่างน้อย 32 ตัวอักษรสุ่ม)
# สร้างอัตโนมัติ: bash scripts/setup-production.sh
JWT_SECRET=change-me-in-production

# development | production — production จะ block startup ถ้า config ไม่ปลอดภัย
APP_ENV=development

# CORS — คั่นด้วยจุลภาค หรือ * สำหรับ dev เท่านั้น
# production: CORS_ORIGINS=https://your-domain.com
CORS_ORIGINS=*

# Super Admin เริ่มต้น (สร้างครั้งแรกเท่านั้น — เปลี่ยนรหัสทันทีหลัง login)
SUPERADMIN_USERNAME=admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=admin1234
