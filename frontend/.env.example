# URL backend สำหรับ Netlify proxy (build time) — ไม่มี /api ท้าย
# ตั้งใน Netlify → Site settings → Environment variables
# BACKEND_URL=https://stock-analyzer-api.onrender.com

# ถ้าไม่ใช้ proxy และเรียก API ข้ามโดเมนตรง (ต้องตั้ง CORS + cookie บน backend)
# VITE_API_URL=https://stock-analyzer-api.onrender.com/api

# Ko-fi (optional — ถ้าไม่ตั้งจะอ่านจาก /api/config/public)
# VITE_BMC_URL=https://ko-fi.com/yourname
